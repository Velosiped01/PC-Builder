<Window x:Class="ProjectWPFLooksGreat.AddNewComponent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectWPFLooksGreat"
        mc:Ignorable="d"
        Title="AddNewComponent" Height="400" Width="600">
    <Grid>
        <ComboBox x:Name="componentCombobox" HorizontalAlignment="Left" Height="28" Margin="337,36,0,0" VerticalAlignment="Top" Width="227" Background="#FF9A9A9A" BorderBrush="Black" SelectionChanged="componentCombobox_SelectionChanged" Cursor="Hand">
            <ComboBoxItem Content="CPU"/>
            <ComboBoxItem Content="Mother board"/>
            <ComboBoxItem Content="GPU"/>
        </ComboBox>
        <TextBox x:Name="ModelNameTextBox" HorizontalAlignment="Left" Height="28" Margin="31,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="152" Background="#FFE3E0E0"/>
        <TextBox x:Name="SocketTextBox" HorizontalAlignment="Left" Height="28" Margin="31,69,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="152" Background="#FFE3E0E0"/>
        <TextBox x:Name="TdpTextBox" HorizontalAlignment="Left" Height="28" Margin="31,102,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="152" Background="#FFE3E0E0"/>
        <TextBox x:Name="FreqTextBox" HorizontalAlignment="Left" Height="28" Margin="31,135,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="152" Background="#FFE3E0E0"/>
        <Button x:Name="addComponentButton" Content="ADD" HorizontalAlignment="Left" Height="47" Margin="451,301,0,0" VerticalAlignment="Top" Width="113" Background="#FFC8C8C8" BorderBrush="Black" Click="addComponentButton_Click"/>
        <TextBox x:Name="ramtextbox" HorizontalAlignment="Left" Height="28" Margin="31,168,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="152" Background="#FFE3E0E0"/>

    </Grid>
</Window>
